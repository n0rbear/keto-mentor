generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FoodSource {
  usda_fdc
  bls
  open_database
  open_food_facts
  manufacturer
  barcode
  user_input
  ai_ocr
  /// Authoritative external-evidence fallback (2026-09-16): a Food whose
  /// nutrition was extracted from a fetched, tier-classified webpage (never
  /// from AI model memory) after every curated/local/USDA/OFF path was
  /// genuinely exhausted. Kept distinct from bls/usda_fdc/open_food_facts so
  /// it is never mistaken for a curated dataset — see web-evidence-fallback.ts.
  web_evidence
  /// Last-resort AI nutrition ESTIMATE (2026-09-16) — explicitly NOT
  /// authoritative evidence. Used only after local/BLS/USDA/web_evidence are
  /// all genuinely exhausted, the model's own general knowledge produced a
  /// structurally-valid estimate, and the requesting user explicitly
  /// accepted it (never auto-persisted). Always createdById-scoped to that
  /// one user — never visible to any other user's resolution (searchFoods
  /// only ever queries createdById: null). If the user later edits these
  /// values by hand, the row's source transitions to user_input (see
  /// PATCH /foods/:id) — it must never keep reading as an AI estimate once
  /// a human has corrected it. See ai-nutrition-estimation.ts.
  ai_estimated
}

enum EntitlementPlan {
  free
  premium
}

enum RecipeVisibility {
  private
  public
  unlisted
}

enum RecipeSourceType {
  manual
  schema_org
  ai_structured
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  locale       String        @default("hu")
  email        String?       @unique
  emailVerifiedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  sessions     Session[]
  meals        Meal[]
  entitlements Entitlement[]
  recipes      Recipe[]
  plates       UserPlate[]
}

// The user's own measured plates for plate-photo portion estimation. Only
// the outer rim diameter is kept; photos are never stored.
/// The user's own plates (owner decision 2026-09-26, roadmap D): measured
/// once, never photographed. "deep": capacityMl (filled with water to the
/// brim); "flat": diameterMm (rim to rim). UserPlate_kind_check enforces
/// that the measure matching the kind is present.
model UserPlate {
  id         String   @id @default(cuid())
  userId     String
  name       String
  kind       String   @default("flat")
  capacityMl Float?
  diameterMm Float?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshHash  String
  deviceLabel  String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  goal          String?
  dailyKcal     Int      @default(1800)
  dailyNetCarbs Int      @default(25)
  dailyProtein  Int      @default(110)
  dailyFat      Int      @default(130)
  dailyFiber    Int      @default(25)
  preferences   String[] @default([])
  avoidedFoods  String[] @default([])
  allergies     String[] @default([])
  onboardingDone Boolean @default(false)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Entitlement {
  id        String          @id @default(cuid())
  userId    String
  plan      EntitlementPlan @default(free)
  features  String[]        @default([])
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  expiresAt DateTime?
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Food {
  id          String       @id @default(cuid())
  name        String
  names       Json?
  synonyms    Json?
  brand       String?
  barcode     String?
  source      FoodSource   @default(user_input)
  sourceId    String?
  originalName String?
  category    String?
  searchText  String       @default("")
  provenance  Json?
  servingUnit String?
  servingGrams Float?
  kcalPer100g Float
  fatPer100g  Float
  proteinPer100g Float
  carbsPer100g Float
  fiberPer100g Float @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  nutrients   FoodNutrient[]
  mealItems   MealItem[]
  recipeIngredients RecipeIngredient[]
  aliases     FoodAlias[]
  servings    FoodServing[]

  @@index([name])
  @@index([barcode])
  @@unique([source, sourceId])
}

model FoodAlias {
  id              String @id @default(cuid())
  foodId          String
  alias           String
  normalizedAlias String
  locale          String @default("und")
  kind            String @default("synonym")
  confidence      Float @default(1)
  provenance      Json?
  createdAt       DateTime @default(now())
  food            Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, normalizedAlias, locale])
  @@index([normalizedAlias])
}

model FoodServing {
  id          String @id @default(cuid())
  foodId      String
  key         String
  unit        String
  labels      Json?
  grams       Float
  isEstimated Boolean @default(false)
  confidence  Float @default(1)
  provenance  Json
  createdAt   DateTime @default(now())
  food        Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, key])
  @@index([foodId])
}

model Nutrient {
  id       String @id @default(cuid())
  key      String @unique
  label    String
  unit     String
  group    String
  foods    FoodNutrient[]
}

model FoodNutrient {
  foodId     String
  nutrientId String
  amountPer100g Float
  food       Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrient   Nutrient @relation(fields: [nutrientId], references: [id], onDelete: Cascade)

  @@id([foodId, nutrientId])
}

model Meal {
  id        String     @id @default(cuid())
  userId    String
  title     String
  eatenAt   DateTime   @default(now())
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     MealItem[]
}

model MealItem {
  /// Exactly one of foodId and recipeId is required by MealItem_exactly_one_source_check.
  id            String @id @default(cuid())
  mealId        String
  foodId        String?
  recipeId      String?
  quantityGrams Float
  displayName   String?
  snapshotKcal Float?
  snapshotFat Float?
  snapshotProtein Float?
  snapshotCarbs Float?
  snapshotFiber Float?
  /// The consumed portion's netCarbs, computed once (sum of per-ingredient-clamped
  /// values, scaled linearly to this portion) at the moment a recipe-backed item is
  /// created or its quantity is corrected — never re-derived from snapshotCarbs/
  /// snapshotFiber, which would re-clamp an already-aggregated total. Null on rows
  /// written before this column existed; see nutrition.ts's itemTotals for the
  /// documented legacy fallback.
  snapshotNetCarbs Float?
  snapshotNutrients Json?
  inputQuantity Float?
  inputUnit String?
  conversionSnapshot Json?
  meal          Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food          Food?  @relation(fields: [foodId], references: [id])
  recipe        Recipe? @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@index([recipeId])
}

model Recipe {
  id                  String @id @default(cuid())
  userId              String
  title               String
  description         String?
  instructions        String[] @default([])
  servings            Float?
  finishedWeightGrams Float?
  visibility          RecipeVisibility @default(private)
  sourceType          RecipeSourceType @default(manual)
  sourceUrl           String?
  provenance          Json?
  forkedFromRecipeId  String?
  deletedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients         RecipeIngredient[]
  mealItems           MealItem[]
  forkedFrom          Recipe? @relation("RecipeForks", fields: [forkedFromRecipeId], references: [id], onDelete: SetNull)
  forks               Recipe[] @relation("RecipeForks")

  @@index([userId, deletedAt])
  @@index([visibility, deletedAt, createdAt])
  @@index([title])
}

model RecipeIngredient {
  id            String @id @default(cuid())
  recipeId      String
  foodId        String?
  quantityGrams Float?
  originalText  String?
  preparation   String?
  sourceGroup   String?
  role          RecipeIngredientRole @default(core)
  optional      Boolean @default(false)
  includedInBaseNutrition Boolean @default(true)
  roleProvenance Json?
  sortOrder     Int @default(0)
  recipe        Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food          Food? @relation(fields: [foodId], references: [id])

  @@index([recipeId, sortOrder])
  @@index([foodId])
}

enum RecipeIngredientRole {
  core
  seasoning
  garnish
  serving_accompaniment
}
